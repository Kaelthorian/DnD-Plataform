{
  "name": "dnd-character-sheet-desktop",
  "version": "3.0.0",
  "description": "Planilla de personaje DnD de escritorio",
  "main": "main.js",
  "author": "WallyCode",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=& electron .",
    "dist": "set ELECTRON_RUN_AS_NODE=& electron-builder --win nsis",
    "dist:portable": "set ELECTRON_RUN_AS_NODE=& electron-builder --win portable"
  },
  "build": {
    "appId": "com.wallycode.dndcharactersheet",
    "productName": "Planilla DnD",
    "directories": {
      "output": "installer-pdf-fields"
    },
    "files": [
      "index.html",
      "races.json",
      "backgrounds.json",
      "classes.json",
      "spells.json",
      "5etools-src-main/data/feats.json",
      "5etools-src-main/data/backgrounds.json",
      "5etools-src-main/data/class/index.json",
      "5etools-src-main/data/class/class-*.json",
      "5etools-src-main/data/optionalfeatures.json",
      "5etools-src-main/data/races.json",
      "5etools-src-main/data/items.json",
      "5etools-src-main/data/items-base.json",
      "5etools-src-main/data/languages.json",
      "DnD_5E_CharacterSheet_FormFillable.pdf",
      "main.js",
      "preload.js",
      "package.json",
      "node_modules/pdfjs-dist/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Planilla DnD"
    }
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "pdfjs-dist": "^6.0.227"
  }
}
