{
  "name": "dnd-character-sheet-desktop",
  "version": "9.0.0",
  "description": "Planilla de personaje DnD de escritorio",
  "main": "src/app/main/main.js",
  "author": "WallyCode",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build:dm-screen": "node ./scripts/ensure-dm-screen-build.js --force",
    "build:dm-screen:css": "tailwindcss -c ./src/app/renderer/dm-screen/tailwind.config.cjs -i ./src/app/renderer/dm-screen/styles.css -o ./src/app/renderer/dm-screen/dist/dm-screen.css --minify",
    "build:dm-screen:js": "vite build --config ./src/app/renderer/dm-screen/vite.config.mjs",
    "prestart": "node ./scripts/ensure-dm-screen-build.js",
    "start": "set ELECTRON_RUN_AS_NODE=& electron .",
    "test": "npm run test:engine && npm run test:services",
    "test:backgrounds": "node tests/engine/backgrounds.test.js",
    "test:engine": "node tests/engine/backgrounds.test.js && node tests/engine/feat-registry.test.js && node tests/engine/spell-registry.test.js && node tests/engine/resource-state.test.js && node tests/engine/long-rest.test.js",
    "test:services": "node tests/services/obsidian-service.test.js && node tests/services/live-sheet-server.test.js",
    "predist": "node ./scripts/ensure-dm-screen-build.js",
    "dist": "set ELECTRON_RUN_AS_NODE=& electron-builder --win nsis",
    "predist:portable": "node ./scripts/ensure-dm-screen-build.js",
    "dist:portable": "set ELECTRON_RUN_AS_NODE=& electron-builder --win portable"
  },
  "build": {
    "appId": "com.wallycode.dndcharactersheet",
    "productName": "Planilla DnD",
    "directories": {
      "output": "installer-pdf-fields"
    },
    "files": [
      "src/app/**",
      "src/data/**",
      "src/engine/**",
      "src/services/**",
      "src/ui/**",
      "Tokens/**",
      "vendor/5etools-src-main/data/feats.json",
      "vendor/5etools-src-main/data/backgrounds.json",
      "vendor/5etools-src-main/data/class/index.json",
      "vendor/5etools-src-main/data/class/class-*.json",
      "vendor/5etools-src-main/data/optionalfeatures.json",
      "vendor/5etools-src-main/data/races.json",
      "vendor/5etools-src-main/data/items.json",
      "vendor/5etools-src-main/data/items-base.json",
      "vendor/5etools-src-main/data/conditionsdiseases.json",
      "vendor/5etools-src-main/data/languages.json",
      "package.json",
      "node_modules/pdfjs-dist/**",
      "node_modules/ws/**",
      "node_modules/three/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Planilla DnD"
    }
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^3.4.17",
    "vite": "^8.1.0"
  },
  "dependencies": {
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.184.0",
    "ws": "^8.21.0"
  }
}
