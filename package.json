{
  "name": "dnd-character-sheet-desktop",
  "version": "10.1.10",
  "description": "Desktop DnD character sheet",
  "main": "src/app/main/main.js",
  "author": "WallyCode",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build:dm-screen": "node ./scripts/ensure-dm-screen-build.js --force",
    "build:dm-screen:css": "tailwindcss -c ./src/app/renderer/dm-screen/tailwind.config.cjs -i ./src/app/renderer/dm-screen/styles.css -o ./src/app/renderer/dm-screen/dist/dm-screen.css --minify",
    "build:dm-screen:js": "vite build --config ./src/app/renderer/dm-screen/vite.config.mjs",
    "prestart": "node ./scripts/ensure-dm-screen-build.js",
    "start": "set ELECTRON_RUN_AS_NODE=& electron .",
    "test": "npm run test:i18n && npm run test:engine && npm run test:services && npm run test:renderer",
    "test:i18n": "node scripts/check-i18n.js",
    "test:backgrounds": "node tests/engine/backgrounds.test.js",
    "test:engine": "node tests/engine/backgrounds.test.js && node tests/engine/feat-registry.test.js && node tests/engine/spell-registry.test.js && node tests/engine/resource-state.test.js && node tests/engine/long-rest.test.js && node tests/engine/class-level3-mechanics.test.js",
    "test:services": "node tests/services/obsidian-service.test.js && node tests/services/live-sheet-server.test.js",
    "test:renderer": "node tests/renderer/i18n.test.js",
    "predist": "node ./scripts/ensure-dm-screen-build.js",
    "dist": "node ./scripts/run-electron-builder.js --win nsis",
    "publish:win": "node ./scripts/run-electron-builder.js --ensure-dm-screen --win nsis --publish always",
    "predist:portable": "node ./scripts/ensure-dm-screen-build.js",
    "dist:portable": "node ./scripts/run-electron-builder.js --win portable"
  },
  "build": {
    "appId": "com.wallycode.dndcharactersheet",
    "productName": "DnD Character Sheet",
    "directories": {
      "output": "installer-pdf-fields"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Kaelthorian",
        "repo": "DnD-Plataform",
        "releaseType": "release"
      }
    ],
    "electronUpdaterCompatibility": ">=2.16",
    "files": [
      "src/app/**",
      "src/data/**",
      "src/engine/**",
      "src/services/**",
      "src/ui/**",
      "Tokens/**",
      "vendor/5etools-src-main/data/feats.json",
      "vendor/5etools-src-main/data/backgrounds.json",
      "vendor/5etools-src-main/data/class/index.json",
      "vendor/5etools-src-main/data/class/class-*.json",
      "vendor/5etools-src-main/data/optionalfeatures.json",
      "vendor/5etools-src-main/data/races.json",
      "vendor/5etools-src-main/data/items.json",
      "vendor/5etools-src-main/data/items-base.json",
      "vendor/5etools-src-main/data/conditionsdiseases.json",
      "vendor/5etools-src-main/data/languages.json",
      "package.json",
      "node_modules/pdfjs-dist/**",
      "node_modules/ws/**",
      "node_modules/three/**"
    ],
    "win": {
      "artifactName": "DnD-Character-Sheet-Setup-${version}.${ext}",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DnD Character Sheet"
    }
  },
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3",
    "tailwindcss": "^3.4.17",
    "vite": "^8.1.0"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.184.0",
    "ws": "^8.21.0"
  }
}
